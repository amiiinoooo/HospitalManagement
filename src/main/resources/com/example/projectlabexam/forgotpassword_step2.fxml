<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.projectlabexam.ForgotPasswordController"
      spacing="10" alignment="CENTER" style="-fx-padding: 20;">
    
    <Label text="Forgot Password - Step 2" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    <Label text="Enter the verification token sent to your email:" style="-fx-font-size: 14px;" />

    <!-- This must match the Java field name: codeField -->
    <TextField fx:id="codeField" promptText="Enter 4-digit code" prefWidth="150"/>

    <Button text="Verify" onAction="#handleVerifyCode"/>
    <Button text="Resend Code" onAction="#handleResendCode"/>

    <Label fx:id="messageLabel" style="-fx-text-fill: red;"/>
</VBox>
