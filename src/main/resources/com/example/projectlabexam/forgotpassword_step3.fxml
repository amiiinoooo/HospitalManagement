<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projectlabexam.ForgotPasswordController" spacing="10" alignment="CENTER">
    <Label text="Forgot Password - Step 3" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
        <Label text="Enter your new password:" style="-fx-font-size: 14px;" />

    <PasswordField fx:id="newPasswordField" promptText="Enter new password" />
    <Button text="Change Password" onAction="#handleChangePassword" />
    <Label fx:id="messageLabel" style="-fx-text-fill: red;" />
</VBox>
