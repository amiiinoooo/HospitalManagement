<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projectlabexam.VerifyController" spacing="10" alignment="CENTER">
    <Label text="Enter the verification token sent to your email:" />
    <HBox spacing="5" alignment="CENTER">
        <TextField fx:id="tokenField1" maxWidth="50" />
        <TextField fx:id="tokenField2" maxWidth="50" />
        <TextField fx:id="tokenField3" maxWidth="50" />
        <TextField fx:id="tokenField4" maxWidth="50" />
    </HBox>
    <Button text="Verify" onAction="#handleVerify" />
    <Button text="Resend Code" onAction="#handleResendCode" />
    <Label fx:id="messageLabel" textFill="red" />
</VBox>
