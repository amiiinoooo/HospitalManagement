<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projectlabexam.ForgotPasswordController" spacing="10" alignment="CENTER">
    <Label text="Forgot Password" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    <TextField fx:id="emailField" promptText="Enter your email" />
    <Button text="Send Code" onAction="#handleSendCode" />
    <TextField fx:id="codeField" promptText="Enter the 4-digit code" />
    <PasswordField fx:id="newPasswordField" promptText="Enter new password" />
    <Button text="Change Password" onAction="#handleChangePassword" />
    <Label fx:id="messageLabel" style="-fx-text-fill: red;" />
</VBox>
