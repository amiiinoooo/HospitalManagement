<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.projectlabexam.DashboardController"
            stylesheets="@style.css">

    <!-- Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="header-bar">
            <Label text="🏨 Customer Dashboard" styleClass="header-title" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Label fx:id="customerNameLabel" text="Customer: John Doe" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Sign Out" onAction="#backToLogin" />
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <VBox spacing="20" alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <TitledPane text="Book a room" expanded="true">
                <VBox spacing="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <HBox spacing="10">
                        <Label text="Select Room:"/>
                        <ComboBox fx:id="roomComboBox"/>
                    </HBox>
                    <HBox spacing="10">
                        <Label text="Check-in:"/>
                        <DatePicker fx:id="checkInDate"/>
                        <Label text="Check-out:"/>
                        <DatePicker fx:id="checkOutDate"/>
                    </HBox>

                    <Button text="Book" onAction="#handleBooking"/>
                </VBox>
            </TitledPane>

            <TitledPane text="Result" expanded="true">
                <VBox spacing="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <Label fx:id="bookingDetails"/>
                </VBox>
            </TitledPane>

            <TitledPane text="View my bookings" expanded="false">
                <VBox spacing="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <TableView fx:id="bookingHistoryTable" prefHeight="175" minHeight="100" maxHeight="250">
                        <columns>                            <TableColumn fx:id="historyRoomColumn" text="Room" prefWidth="120" minWidth="100" />
                            <TableColumn fx:id="historyCheckInColumn" text="Check-in" prefWidth="140" minWidth="120" />
                            <TableColumn fx:id="historyCheckOutColumn" text="Check-out" prefWidth="140" minWidth="120" />
                            <TableColumn fx:id="historyStatusColumn" text="Status" prefWidth="110" minWidth="90" />
                            <TableColumn fx:id="historyActionsColumn" text="Actions" prefWidth="100" minWidth="90" />
                        </columns>
                    </TableView>
                </VBox>
            </TitledPane>

            <Button fx:id="keycardButton" text="Use Keycard" onAction="#handleKeycardUse" disable="true"/>

        </VBox>
    </center>

</BorderPane>