<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projectlabexam.ForgotPasswordController" spacing="10" alignment="CENTER">
     <Label text="Forgot Password - Step 1" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    <Label text="Enter your email:" style="-fx-font-size: 14px;" />
    <TextField fx:id="emailField" promptText="Email" />
    <Button text="Send Code" onAction="#handleSendCode" />
    <Label fx:id="messageLabel" style="-fx-text-fill: red;" />
</VBox>
